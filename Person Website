
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="theme-color" content="#080d1b">
    <meta name="description" content="Karl — Personal Portfolio. A personal space for history, medicine, science and knowledge.">

    <title>KARL // Personal Archive</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Noto+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #080b14;
            --panel: #0d1424;
            --blue: #1747a6;
            --bright: #5c9dff;
            --cyan: #8be9ff;
            --white: #e8efff;
            --muted: #8391ad;
            --line: rgba(113, 159, 255, 0.22);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 85px;
        }

        body {
            background:
                radial-gradient(ellipse at 80% 0%, #142958 0%, transparent 40%),
                radial-gradient(ellipse at 0% 45%, #101b36 0%, transparent 35%),
                var(--bg);
            color: var(--white);
            font-family: "Noto Sans Thai", sans-serif;
            line-height: 1.8;
            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 10;
            opacity: 0.12;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.22'/%3E%3C/svg%3E");
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button, a {
            -webkit-tap-highlight-color: transparent;
        }

        .container {
            width: min(1100px, 90%);
            margin: auto;
        }

        .mono {
            font-family: "IBM Plex Mono", monospace;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 20;
            background: rgba(8, 11, 20, 0.88);
            border-bottom: 1px solid var(--line);
            backdrop-filter: blur(16px);
        }

        .nav {
            min-height: 72px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: "IBM Plex Mono", monospace;
            font-weight: 700;
            letter-spacing: 2px;
        }

        .brand-icon {
            display: grid;
            place-items: center;
            width: 39px;
            height: 39px;
            background: linear-gradient(135deg, #2456bd, #0a1835);
            border: 1px solid var(--bright);
            box-shadow: 0 0 20px #2456bd40;
            font-size: 25px;
            color: white;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 25px;
            font-family: "IBM Plex Mono", monospace;
            font-size: 12px;
            color: var(--muted);
        }

        .nav-links a {
            transition: color .2s;
        }

        .nav-links a:hover {
            color: var(--cyan);
        }

        .hero {
            min-height: 670px;
            display: grid;
            grid-template-columns: 1.2fr .8fr;
            align-items: center;
            gap: 55px;
            padding-top: 65px;
            padding-bottom: 80px;
        }

        .eyebrow {
            color: var(--cyan);
            font: 12px "IBM Plex Mono", monospace;
            letter-spacing: 2px;
            margin-bottom: 24px;
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            border: 1px solid var(--line);
            padding: 6px 12px;
            color: var(--muted);
            font: 11px "IBM Plex Mono", monospace;
            margin-bottom: 25px;
            background: #101a30;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #66e6b0;
            box-shadow: 0 0 10px #66e6b0;
        }

        h1 {
            font: 700 clamp(52px, 9vw, 100px)/1 "IBM Plex Mono", monospace;
            letter-spacing: -5px;
            margin-bottom: 18px;
        }

        h1 span {
            color: var(--bright);
            text-shadow: 0 0 35px #3979ff55;
        }

        .hero-subtitle {
            font-size: 17px;
            color: var(--cyan);
            margin-bottom: 17px;
        }

        .hero-description {
            max-width: 520px;
            color: #aab6ce;
            font-size: 14px;
            line-height: 2;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 30px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 12px 19px;
            border: 1px solid var(--line);
            font: 12px "IBM Plex Mono", monospace;
            transition: .25s;
        }

        .btn-primary {
            background: var(--blue);
            border-color: var(--bright);
            color: white;
        }

        .btn:hover {
            transform: translateY(-3px);
            border-color: var(--cyan);
            box-shadow: 0 5px 25px #326dff25;
        }

        .hero-art {
            position: relative;
            display: grid;
            place-items: center;
            min-height: 370px;
        }

        .art-frame {
            width: min(100%, 350px);
            aspect-ratio: 1;
            position: relative;
            display: grid;
            place-items: center;
            border: 1px solid #5c9dff70;
            background:
                linear-gradient(135deg, #16366c70, transparent 55%),
                repeating-linear-gradient(0deg, transparent, transparent 39px, #5c9dff0c 40px),
                repeating-linear-gradient(90deg, transparent, transparent 39px, #5c9dff0c 40px),
                #0b1120;
            box-shadow: 0 0 70px #1644a322, inset 0 0 50px #1644a322;
        }

        .art-frame::before,
        .art-frame::after {
            content: "";
            position: absolute;
            width: 30px;
            height: 30px;
            border-color: var(--cyan);
            border-style: solid;
        }

        .art-frame::before {
            top: -5px;
            left: -5px;
            border-width: 2px 0 0 2px;
        }

        .art-frame::after {
            bottom: -5px;
            right: -5px;
            border-width: 0 2px 2px 0;
        }

        .big-k {
            font: 700 clamp(150px, 25vw, 240px)/1 "IBM Plex Mono", monospace;
            color: transparent;
            -webkit-text-stroke: 2px var(--bright);
            text-shadow: 0 0 50px #367dff55;
            animation: float 5s ease-in-out infinite;
        }

        .art-label {
            position: absolute;
            bottom: 17px;
            left: 20px;
            right: 20px;
            display: flex;
            justify-content: space-between;
            font: 10px "IBM Plex Mono", monospace;
            color: var(--muted);
        }

        .art-coordinate {
            position: absolute;
            top: 15px;
            right: 15px;
            color: var(--cyan);
            font: 10px "IBM Plex Mono", monospace;
        }

        .side-note {
            position: absolute;
            right: -25px;
            top: 20%;
            writing-mode: vertical-rl;
            font: 10px "IBM Plex Mono", monospace;
            letter-spacing: 3px;
            color: var(--muted);
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .ticker {
            overflow: hidden;
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
            background: #0b1221;
            padding: 13px 0;
        }

        .ticker-track {
            display: flex;
            width: max-content;
            gap: 35px;
            animation: ticker 28s linear infinite;
            font: 11px "IBM Plex Mono", monospace;
            color: var(--muted);
            letter-spacing: 2px;
        }

        .ticker-track span {
            white-space: nowrap;
        }

        .ticker-track b {
            color: var(--bright);
        }

        @keyframes ticker {
            to { transform: translateX(-50%); }
        }

        section {
            padding: 100px 0;
        }

        .section-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--line);
        }

        .section-index {
            font: 12px "IBM Plex Mono", monospace;
            color: var(--bright);
            margin-bottom: 8px;
        }

        h2 {
            font-size: clamp(25px, 4vw, 36px);
            line-height: 1.4;
            font-weight: 600;
        }

        .section-caption {
            font: 11px "IBM Plex Mono", monospace;
            color: var(--muted);
        }

        .about-grid {
            display: grid;
            grid-template-columns: 1.1fr .9fr;
            gap: 25px;
        }

        .panel {
            background: linear-gradient(145deg, #101a2d, #0a0f1a);
            border: 1px solid var(--line);
            padding: 30px;
        }

        .panel-tag {
            font: 11px "IBM Plex Mono", monospace;
            color: var(--cyan);
            margin-bottom: 18px;
        }

        .panel p {
            font-size: 14px;
            color: #aab6ce;
            line-height: 2.1;
        }

        .quote {
            border-left: 2px solid var(--bright);
            padding-left: 20px;
            margin-top: 24px;
            color: var(--white);
            font-size: 15px;
        }

        .facts {
            display: grid;
            gap: 0;
        }

        .fact {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
            padding: 16px 0;
            border-bottom: 1px solid var(--line);
            font-size: 13px;
        }

        .fact:last-child {
            border-bottom: 0;
        }

        .fact-label {
            color: var(--muted);
        }

        .fact-value {
            text-align: right;
            color: var(--white);
        }

        .interests {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .interest-card {
            position: relative;
            min-height: 230px;
            padding: 25px;
            background: linear-gradient(145deg, #111d35, #0a0e18);
            border: 1px solid var(--line);
            overflow: hidden;
            transition: .3s;
        }

        .interest-card:hover {
            transform: translateY(-5px);
            border-color: var(--bright);
            box-shadow: 0 10px 35px #1747a622;
        }

        .interest-number {
            font: 11px "IBM Plex Mono", monospace;
            color: var(--bright);
        }

        .interest-icon {
            font-size: 35px;
            margin: 24px 0 12px;
            filter: grayscale(20%);
        }

        .interest-card h3 {
            font-size: 19px;
            margin-bottom: 7px;
        }

        .interest-card p {
            font-size: 12px;
            color: var(--muted);
            line-height: 1.9;
        }

        .interest-card::after {
            content: attr(data-code);
            position: absolute;
            right: -8px;
            bottom: -28px;
            font: 700 85px "IBM Plex Mono", monospace;
            color: #5c9dff08;
            pointer-events: none;
        }

        .manifesto {
            position: relative;
            padding: 55px;
            background:
                linear-gradient(110deg, #102652e8, #0b1120f2),
                repeating-linear-gradient(0deg, transparent, transparent 30px, #5c9dff10 31px);
            border: 1px solid #5c9dff55;
        }

        .manifesto h3 {
            font-size: 24px;
            margin-bottom: 20px;
        }

        .manifesto p {
            max-width: 760px;
            color: #b6c5e0;
            font-size: 14px;
            line-height: 2.2;
        }

        .manifesto-mark {
            position: absolute;
            right: 30px;
            top: 15px;
            font: 100px "IBM Plex Mono", monospace;
            color: #5c9dff13;
        }

        .social-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .social-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 20px 22px;
            background: #0d1424;
            border: 1px solid var(--line);
            transition: .25s;
        }

        .social-link:hover {
            border-color: var(--bright);
            background: #111e38;
            transform: translateX(3px);
        }

        .social-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .social-icon {
            display: grid;
            place-items: center;
            width: 42px;
            height: 42px;
            background: #14284b;
            border: 1px solid var(--line);
            font: 600 14px "IBM Plex Mono", monospace;
            color: var(--cyan);
        }

        .social-name {
            font-size: 14px;
            font-weight: 600;
        }

        .social-handle {
            font: 10px "IBM Plex Mono", monospace;
            color: var(--muted);
            overflow-wrap: anywhere;
        }

        .social-arrow {
            color: var(--bright);
            font-size: 20px;
        }

        .contact-note {
            margin-top: 25px;
            color: var(--muted);
            font-size: 12px;
            line-height: 2;
        }

        footer {
            border-top: 1px solid var(--line);
            padding: 30px 0;
            background: #080b14;
        }

        .footer-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .footer-brand {
            font: 600 13px "IBM Plex Mono", monospace;
            letter-spacing: 2px;
        }

        .footer-copy {
            font: 10px "IBM Plex Mono", monospace;
            color: var(--muted);
        }

        .back-top {
            color: var(--cyan);
            font: 11px "IBM Plex Mono", monospace;
        }

        .reveal {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity .7s ease, transform .7s ease;
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        @media (max-width: 760px) {
            .nav {
                min-height: 65px;
            }

            .nav-links {
                gap: 12px;
                font-size: 10px;
            }

            .nav-links a:nth-child(2) {
                display: none;
            }

            .hero {
                grid-template-columns: 1fr;
                gap: 35px;
                padding-top: 65px;
                min-height: auto;
            }

            .hero-art {
                min-height: 310px;
            }

            .art-frame {
                width: min(80%, 300px);
            }

            .side-note {
                right: 0;
            }

            .about-grid {
                grid-template-columns: 1fr;
            }

            .interests {
                grid-template-columns: 1fr;
            }

            .interest-card {
                min-height: 190px;
            }

            .social-grid {
                grid-template-columns: 1fr;
            }

            section {
                padding: 70px 0;
            }

            .section-heading {
                align-items: flex-start;
                flex-direction: column;
                gap: 10px;
            }

            .manifesto {
                padding: 30px 24px;
            }

            .manifesto-mark {
                right: 15px;
                font-size: 75px;
            }

            h1 {
                letter-spacing: -3px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
            }

            .reveal {
                opacity: 1;
                transform: none;
            }
        }
    </style>
</head>

